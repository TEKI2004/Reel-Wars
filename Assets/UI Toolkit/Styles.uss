.clapper-panel {
    position: absolute;
    width: 512px;
    height: 448px;
    -unity-background-scale-mode: stretch-to-fill;
}

.left-clapper {
    top: 36px;
    left: 180px;
    background-image: url("project://database/Assets/UI%20Toolkit/Images/LeftClapper.png?fileID=2800000&guid=2902130023911db43b083984d75c9822&type=3#LeftClapper");
}

.right-clapper {
    top: 36px;
    right: 180px;
    background-image: url("project://database/Assets/UI%20Toolkit/Images/RightClapper.png?fileID=2800000&guid=cb3466c463a4d664dad3317401d0ae2a&type=3#RightClapper");
}

.player-name {
    position: absolute;
    top: 167px;
    left: 11px;
    right: 4px;
    height: 24px;

    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: lower-center;
}

.unit-row {
    position: absolute;
    top: 225px;
    left: 19px;
    right: 13px;
    height: 101px;

    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.unit-button {
    width: 145px;
    height: 100px;

    font-size: 40px;
    -unity-text-align: middle-center;

    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding-top: 0px;
    padding-bottom: 0px;

    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
}

.passive-title {
    position: absolute;
    top: 363px;
    left: 42px;
    width: 110px;
    height: 26px;

    font-size: 16px;
    color: white;
    -unity-text-align: middle-center;
}

.passive-value {
    position: absolute;
    top: 366px;
    left: 176px;
    right: 22px;
    height: 26px;

    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.genre-title {
    position: absolute;
    top: 399px;
    left: 31px;
    width: 302px;
    height: 14px;

    font-size: 14px;
    color: white;
    -unity-text-align: middle-center;
}

.genre-value {
    position: absolute;
    top: 410px;
    left: 43px;
    width: 276px;
    height: 29px;

    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.boxoffice-title {
    position: absolute;
    top: 395px;
    right: 22px;
    width: 139px;
    height: 20px;

    font-size: 14px;
    color: white;
    -unity-text-align: middle-center;
}

.boxoffice-value {
    position: absolute;
    top: 413px;
    right: 23px;
    width: 141px;
    height: 28px;

    font-size: 22px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}



.unit-name {
    height: 16px;
    font-size: 12px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: upper-center;
    margin-top: -6px;
}

.unit-cost {
    height: 16px;
    font-size: 12px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: lower-center;
    margin-bottom: -2px;
}