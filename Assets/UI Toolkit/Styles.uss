.clapper-panel {
    position: absolute;
    width: 512px;
    height: 448px;
    -unity-background-scale-mode: stretch-to-fill;
}

.left-clapper {
    top: 36px;
    left: 180px;
    background-image: url("project://database/Assets/UI%20Toolkit/Images/LeftClapper.png?fileID=2800000&guid=b91c236564fb17d4ea97807f658f98a1&type=3#LeftClapper");
}

.right-clapper {
    top: 36px;
    right: 180px;
    background-image: url("project://database/Assets/UI%20Toolkit/Images/RightClapper.png?fileID=2800000&guid=04b28352872b1994dbb463af1a9be22a&type=3#RightClapper");
}

.player-name {
    position: absolute;
    top: 167px;
    left: 11px;
    right: 4px;
    height: 24px;
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: lower-center;
}

.unit-row-left {
    position: absolute;
    top: 224px;
    left: 20px;
    width: 477px;
    height: 102px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.unit-row-right {
    position: absolute;
    top: 224px;
    left: auto;
    width: 477px;
    height: 102px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    right: 19px;
}

.unit-button {
    width: 150px;
    height: 101px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 255);
    border-width: 0;
    margin-right: 7px;
    margin-left: 7px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

.unit-button.spawn-flash {
    opacity: 0.45;
    background-color: rgb(40, 40, 40);
}

.unit-icon {
    width: 62px;
    height: 62px;
    margin-top: -2px;
    margin-bottom: -2px;
    -unity-background-scale-mode: scale-to-fit;
}

.passive-title {
    position: absolute;
    top: 363px;
    left: 42px;
    width: 110px;
    height: 26px;
    font-size: 16px;
    color: white;
    -unity-text-align: middle-center;
}

.passive-value {
    position: absolute;
    top: 366px;
    left: 176px;
    right: 22px;
    height: 26px;
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.genre-title {
    position: absolute;
    top: 399px;
    left: 31px;
    width: 302px;
    height: 14px;
    font-size: 14px;
    color: white;
    -unity-text-align: middle-center;
}

.genre-value {
    position: absolute;
    top: 410px;
    left: 43px;
    width: 276px;
    height: 29px;
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.boxoffice-title {
    position: absolute;
    top: 395px;
    right: 22px;
    width: 139px;
    height: 20px;
    font-size: 14px;
    color: white;
    -unity-text-align: middle-center;
}

.boxoffice-value {
    position: absolute;
    top: 413px;
    right: 23px;
    width: 141px;
    height: 28px;
    font-size: 22px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.unit-name {
    height: 16px;
    font-size: 12px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: upper-center;
    margin-top: -3px;
}

.unit-cost {
    height: 16px;
    font-size: 12px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: lower-center;
    margin-bottom: -3px;
}

.genre-choice-frame {
    position: absolute;
    top: 580px;
    width: 240px;
    height: 240px;
    background-color: black;
    border-width: 4px;
    border-color: white;
    rotate: 45deg;
}

.genre-choice-frame-left {
    left: 480px;
}

.genre-choice-frame-right {
    right: 480px;
}

.genre-divider {
    position: absolute;
    left: -23px;
    top: 113px;
    width: 280px;
    height: 4px;
    background-color: white;
    rotate: -45deg;
}

.genre-icon {
    position: absolute;
    width: 80px;
    height: 80px;
    left: auto;
    rotate: -45deg;
    -unity-background-scale-mode: scale-to-fit;
}

.top-genre-icon {
    top: 35px;
    left: 35px;
}

.bottom-genre-icon {
    top: auto;
    bottom: 35px;
    left: auto;
    right: 35px;
}

.keybind-circle {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(230, 200, 120);
    background-color: rgb(20, 20, 20);
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
